# Kotak Neo API v2
# consumer_key: from Kotak Neo app → Invest tab → Trade API card
KOTAK_NEO_CONSUMER_KEY=
# mobile_number: registered mobile with country code e.g. +919876543210
KOTAK_NEO_MOBILE_NUMBER=
# ucc: Unique Client Code from your Kotak profile section
KOTAK_NEO_UCC=
# mpin: your 6-digit account MPIN
KOTAK_NEO_MPIN=
# totp_secret: base32 seed shown when you scanned the QR during TOTP registration
KOTAK_NEO_TOTP_SECRET=

# App
APP_ENV=development
SECRET_KEY=change-me-in-production
ALLOWED_ORIGINS=http://localhost:3000

# Supabase / PostgreSQL
DATABASE_URL=postgresql://postgres:password@localhost:5432/tradeos
SUPABASE_URL=
SUPABASE_KEY=

# Claude AI
ANTHROPIC_API_KEY=
